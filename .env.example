# Copy to server/.env (backend) and client/.env (VITE_ vars) before running locally.
# Every value below is a placeholder. Never commit a filled-in copy.

# --- Server ---
NODE_ENV=development
PORT=4000
# Origin allowed by CORS. In production this is the deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Neon Postgres) ---
# Pooled endpoint for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) endpoint. Prisma migrations fail against the pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Auth ---
# At least 32 characters, and random. Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Providers ---
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Free Demo key from https://www.coingecko.com/en/developers/dashboard
# Required in any deployed environment: keyless requests are rate limited per IP
# and that quota is shared with every other caller on the same IP.
COINGECKO_API_KEY=

# Free developer tier token from https://cryptopanic.com/developers/api/
CRYPTOPANIC_AUTH_TOKEN=
CRYPTOPANIC_PLAN=developer

# https://openrouter.ai/keys . Model ID is an env var because free model IDs get delisted.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# --- Seeded demo account (reviewer login) ---
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

# --- Client (Vite) ---
VITE_API_URL=http://localhost:4000
